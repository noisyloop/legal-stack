# Legal Stack — environment configuration reference.
# Copy to .env for local development. NEVER commit real secrets; this file
# documents shape only. See backend/internal/platform/config/config.go for
# validation rules.

# development | test | staging | production
APP_ENV=development

HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=15s

# PostgreSQL (dev credentials match infra/compose/docker-compose.yml)
DATABASE_URL=postgres://app:devpassword@localhost:5432/legalstack?sslmode=disable

# Redis (optional in Phase 1)
REDIS_URL=redis://localhost:6379/0

# Logging: json | text; debug | info | warn | error
LOG_FORMAT=json
LOG_LEVEL=info

# CIDRs whose X-Forwarded-For is trusted. Empty = trust no proxy headers.
# In production, set to the ingress/NGINX network, e.g. 10.0.0.0/8.
TRUSTED_PROXY_CIDRS=

# Per-IP application rate limit
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# JSON request body cap (MiB); uploads use the dedicated multipart flow
MAX_REQUEST_BODY_MIB=1
